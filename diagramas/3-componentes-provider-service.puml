@startuml componentes_provider
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title PetCare - Provider Service - Componentes (C3)

Container(provider_container, "Provider Service (8082)") {
    
    Container(write_side, "WRITE SIDE - Comando") {
        Component(cmd_consumer, "NotificarProveedorCommandConsumer", "Kafka Consumer", "Consume NotificarProveedorCommand del topic saga.comando.notificar-proveedor")
        
        Component(proveedor_service, "ProveedorServiceImpl", "Service", "Procesa comando y crea SolicitudReserva")
    }
    
    Container(read_side, "READ SIDE / EVENTOS") {
        Component(event_pub, "KafkaDomainEventPublisher", "Event Publisher", "Publica ReservaAceptadaEvent, ReservaRechazadaEvent")
    }
    
    Container(internal_api, "Internal API") {
        Component(catalogo_interno, "CatalogoInternoController", "Controller", "GET /interna/** para payment-service\n(promociones activas, costos, disponibilidad)")
    }
    
    Container(persistence, "Persistence") {
        Component(proveedor_repo, "ProveedorRepository", "Repository", "SELECT/INSERT Proveedor, ProveedorServicio, Disponibilidad")
        
        Component(solicitud_repo, "SolicitudReservaRepository", "Repository", "INSERT/UPDATE SolicitudReserva")
    }
    
    Container(controllers, "Público") {
        Component(proveedor_controller, "ProveedorController", "Controller", "GET /api/v1/proveedor/** para clientes")
    }
}

Component(db_provider, "PostgreSQL petcaredb_provider", "Database", "BD separada: Proveedor, ProveedorServicio, Disponibilidad, Promocion, SolicitudReserva, EventoProcesado")

Component(payment_svc, "Payment Service", "8083", "Consulta /interna/**")
Component(kafka, "Kafka", "Message Queue", "Topics: saga.comando.notificar-proveedor, reserva.aceptada, reserva.rechazada")

Rel(kafka, cmd_consumer, "Consume NotificarProveedorCommand")
Rel(cmd_consumer, proveedor_service, "crea SolicitudReserva")
Rel(proveedor_service, solicitud_repo, "INSERT SolicitudReserva")
Rel(proveedor_service, event_pub, "publica evento")
Rel(event_pub, kafka, "Publish ReservaAceptadaEvent o ReservaRechazadaEvent")

Rel(payment_svc, internal_api, "HTTP GET /interna/**")
Rel(catalogo_interno, proveedor_repo, "SELECT data")
Rel(proveedor_repo, db_provider, "SELECT queries")
Rel(solicitud_repo, db_provider, "INSERT/UPDATE queries")

Rel(proveedor_controller, proveedor_repo, "SELECT data")

note bottom of write_side
    **WRITE SIDE:**
    - Consume comando específico
    - Crea SolicitudReserva
    - Publica evento de resultado
end note

note right of db_provider
    **BD Separada (petcaredb_provider):**
    - Aislamiento de datos del proveedor
    - Escalabilidad independiente
    - Estrategia de multi-tenancy
end note

SHOW_LEGEND()
@enduml
Rel(ps_pub, kafka, "ReservaAceptadaEvent / ReservaRechazadaEvent", "Kafka")
Rel(ps_rs_client, rs, "Consulta vacuna, ubicación y has-reservas", "HTTP /interna/**")
Rel(ms, ps_interna, "Promoción activa, usos y costo adicional de modalidad", "HTTP /interna/promociones/**, /interna/servicios/**")
Rel(rs, ps_interna, "Catálogo: proveedor, servicio, modalidades y disponibilidad", "HTTP /interna/**")
Rel(ps_crud, db, "Persiste persona, usuario, dirección y proveedor", "JDBC / MyBatis")
Rel(ps_sol_mapper, db, "Persiste solicitud_reserva", "JDBC / MyBatis")
Rel(ps_disp_mapper, db, "Persiste disponibilidad", "JDBC / MyBatis")
Rel(ps_svc_mappers, db, "Persiste proveedor_servicio y modalidades", "JDBC / MyBatis")
Rel(ps_promo_mapper, db, "Persiste promocion", "JDBC / MyBatis")
Rel(ps_cat_mapper, db, "Consulta catálogo", "JDBC / MyBatis")
Rel(ps_idem, db, "Persiste evento_procesado", "JDBC / MyBatis")

note bottom of ps_consumer
  Las solicitudes solo se crean cuando el orquestador lo ordena:
  provider-service ya no consume reserva.creada.
end note

note bottom of ps_promo
  Promociones globales = promocion.proveedor_id IS NULL (las gestiona el
  ADMIN en /promociones). Las del proveedor se crean en
  /proveedores/my/promociones. payment-service consume cupo (usos_actuales)
  vía /interna/promociones/**.
end note

note bottom of ps_interna
  Endpoints /interna/** quedan permitAll en el SecurityConfig:
  reservation-service y payment-service los consumen vía HTTP
  (ProviderCatalogClient / PagoProviderClient).
end note

LAYOUT_WITH_LEGEND()

@enduml
