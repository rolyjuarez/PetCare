4-clases-secuencia-pago.puml

@startuml
!theme plain
skinparam sequence {
  ArrowColor #2F4F4F
  LifeLineBorderColor #2F4F4F
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #2F4F4F
  ParticipantBackgroundColor #EAF2F8
  BoxBorderColor #566573
  BoxBackgroundColor #F7F9FA
}

autonumber
actor Cliente
participant "API / Frontend" as API
participant "Reservation Service" as Reservation
participant "Saga Orchestrator" as Saga
participant "Payment Service" as Payment
participant "Gateway de Pagos" as Gateway
database "PostgreSQL" as DB

Cliente -> API: solicita pagar reserva
API -> Reservation: confirma reserva existente
Reservation -> DB: UPDATE reserva SET estado = CONFIRMADA
Reservation --> API: reserva confirmada

API -> Saga: se dispara flujo de pago
Saga -> Payment: CrearPagoCommand
Payment -> DB: INSERT pago (PENDIENTE)
Payment -> Gateway: procesarPago()
Gateway --> Payment: tarjeta rechazada / error de cobro

Payment --> Saga: PagoFallidoEvent
Saga -> Saga: transicion estado = PAGO_FALLIDO
Saga -> Reservation: CancelarReservaCommand
Reservation -> DB: UPDATE reserva SET estado = CANCELADA
Reservation --> Saga: ReservaCanceladaEvent

Saga -> Payment: LiberarDescuentoCommand
Payment -> DB: UPDATE promocion SET usos_actuales = GREATEST(usos_actuales - 1, 0)

Saga --> API: respuesta final: pago fallido y reserva cancelada
API --> Cliente: error de pago, reserva anulada

@enduml
