@startuml componentes_payment
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title PetCare - Payment Service - Componentes (C3)

Container(payment_container, "Payment Service (8083)") {
    
    Container(write_side, "WRITE SIDE - Comando") {
        Component(cmd_consumer, "CrearPagoCommandConsumer", "Kafka Consumer", "Consume CrearPagoCommand del topic saga.comando.crear-pago")
        
        Component(pago_service, "PagoServiceImpl", "Service", "Procesa el pago: valida, aplica pipeline de descuentos, llama pasarela")
        
        Component(pipeline, "DescuentoPipeline", "Chain of Filters", "3 etapas: PipePromocionProveedor → PipeRecargoModalidad → PipeTerminal")
        
        Component(pago_repo, "PagoRepository", "Repository", "INSERT/UPDATE en tabla pago")
    }
    
    Container(read_side, "READ SIDE / EVENTOS") {
        Component(event_pub, "KafkaDomainEventPublisher", "Event Publisher", "Publica PagoProcesadoEvent, PagoFallidoEvent, PagoReembolsadoEvent")
    }
    
    Container(external_calls, "Llamadas Externas") {
        Component(provider_client, "PagoProviderClient", "REST Client", "GET /interna/** para consultar promociones activas y costos adicionales")
        
        Component(gateway_client, "PasarelaClient", "REST Client", "Procesa pago en pasarela de pagos (Stripe/PayU)")
    }
    
    Container(controllers, "Público") {
        Component(pago_controller, "PagoController", "Controller", "GET /api/v1/pagos/** para consultas")
    }
}

Component(database, "PostgreSQL petcaredb", "Database", "Tabla: pago")
Component(provider_svc, "Provider Service", "8082", "Endpoints /interna/**")
Component(pasarela, "Pasarela de Pagos", "External", "Procesa transacciones")
Component(kafka, "Kafka", "Message Queue", "Topics: saga.comando.crear-pago, pago.completado, pago.fallido, pago.reembolsado")

Rel(kafka, cmd_consumer, "Consume CrearPagoCommand")
Rel(cmd_consumer, pago_service, "ejecuta pago")
Rel(pago_service, pipeline, "aplica descuentos")
Rel(pipeline, provider_client, "consulta promociones")
Rel(provider_client, provider_svc, "HTTP GET /interna/**")
Rel(pago_service, gateway_client, "procesa transacción")
Rel(gateway_client, pasarela, "HTTP POST")
Rel(pago_service, pago_repo, "persiste pago")
Rel(pago_repo, database, "INSERT/UPDATE")
Rel(pago_service, event_pub, "publica evento")
Rel(event_pub, kafka, "Publish PagoProcesadoEvent o PagoFallidoEvent")
Rel(pago_controller, database, "SELECT pagos")

note bottom of pipeline
    **Pipeline de descuentos:**
    1. PipePromocionProveedor: promociones activas
    2. PipeRecargoModalidad: recargo por modalidad
    3. PipeTerminal: recargo o descuento final
end note

note right of write_side
    **WRITE SIDE:**
    - Consume comando específico
    - Procesa con pipeline de negocio
    - Persiste resultado
    - Publica evento de resultado
end note

SHOW_LEGEND()
@enduml
