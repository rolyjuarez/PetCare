@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #444444
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2F4F4F
}
skinparam database {
  BackgroundColor #EAF4FF
  BorderColor #2B6CB0
}
skinparam cloud {
  BackgroundColor #FFF7E6
  BorderColor #CFA13B
}
skinparam queue {
  BackgroundColor #FDECEC
  BorderColor #C53030
}

title Arquitectura de componentes actual - PetCare

actor Cliente as Cliente
actor Administrador as Administrador
actor Proveedor as Proveedor

package "Frontend" {
  component "Angular SPA" as AngularSPA
  component "Guards / Interceptors / Servicios UI" as FrontendServices
}

package "Backend - Spring Boot (Monolito)" {
  component "Controllers REST" as Controllers

  package "Módulos de negocio" {
    component "Auth" as AuthModule
    component "Persona / Cliente / Usuario" as IdentityModule
    component "Mascota" as MascotaModule
    component "Proveedor / Servicio" as ProveedorModule
    component "Reserva" as ReservaModule
    component "Pago" as PagoModule
    component "Promoción" as PromocionModule
    component "Notificación" as NotificacionModule
    component "Menu / Rol / Permiso" as MenuRolModule
    component "Sucursal / Bitácora / Vacuna" as OpsModule
  }

  package "Infraestructura compartida" {
    component "Security / JWT" as Security
    component "MyBatis + Mappers" as MyBatis
    component "Domain Events" as DomainEvents
    component "Publisher in-process / Kafka" as EventPublisher
    component "Outbox + Scheduler" as Outbox
    component "Consumers Kafka" as EventConsumers
    component "Handlers de eventos" as EventHandlers
    component "Observabilidad / Métricas" as Observability
  }
}

database "PostgreSQL" as Database
queue "Kafka Topics" as Kafka
storage "Almacenamiento local de archivos" as FileStorage
cloud "SMTP Gmail" as EmailService
cloud "Google Maps API" as MapsAPI
component "Prometheus / Grafana" as Monitoring

Cliente --> AngularSPA : usa la aplicación
Administrador --> AngularSPA : administra operaciones
Proveedor --> AngularSPA : gestiona servicios
AngularSPA --> FrontendServices
FrontendServices --> Controllers : HTTP /api/v1

Controllers --> AuthModule
Controllers --> IdentityModule
Controllers --> MascotaModule
Controllers --> ProveedorModule
Controllers --> ReservaModule
Controllers --> PagoModule
Controllers --> PromocionModule
Controllers --> NotificacionModule
Controllers --> MenuRolModule
Controllers --> OpsModule
Controllers --> Security

AuthModule --> Security
AuthModule --> Database : usuarios, roles, credenciales
IdentityModule --> Database : personas, clientes, usuarios
MascotaModule --> Database : mascotas, especies, razas
ProveedorModule --> Database : proveedores, disponibilidades, servicios
ReservaModule --> Database : reservas, estados, asignaciones
PagoModule --> Database : pagos
PromocionModule --> Database : promociones
NotificacionModule --> Database : notificaciones
MenuRolModule --> Database : menús, permisos, roles
OpsModule --> Database : sucursales, bitácoras, vacunas

ReservaModule --> DomainEvents : publica eventos de reserva
PagoModule --> DomainEvents : publica eventos de pago
MascotaModule --> DomainEvents : publica eventos de mascota
AuthModule --> DomainEvents : publica eventos de usuario

DomainEvents --> EventPublisher
EventPublisher --> Outbox : registra evento
Outbox --> Kafka : petcare.reserva.event.v1, petcare.pago.event.v1, petcare.usuario.event.v1
Kafka --> EventConsumers
EventConsumers --> EventHandlers
EventHandlers --> EmailService : correos transaccionales
EventHandlers --> Database : actualiza reacciones / notificaciones
EventHandlers --> FileStorage : archivos adjuntos

MyBatis --> Database : persistencia SQL
Observability --> Monitoring : logs, métricas, trazas
Security --> Database : validación de JWT / sesiones
AngularSPA --> MapsAPI : mapas y geolocalización
AngularSPA --> FileStorage : carga de fotos / archivos

note bottom of Controllers
  API REST expuesta por Spring MVC
  y organizada por módulos de negocio.
end note

note bottom of Outbox
  Patrón outbox para garantizar
  entrega confiable de eventos a Kafka.
end note

@enduml