@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(spa, "SPA Angular", "Angular 21", "Aplicación web de PETCare")
Container(api, "API REST", "Spring Boot 3.4.1", "Backend monolítico modular")

Container_Boundary(frontend_boundary, "Contenedor Frontend") {
  Component(ui, "Interfaz de usuario", "Angular UI", "Vistas de login, dashboard, mascotas, reservas y pagos")
  Component(router, "Navegación", "Angular Router", "Controla las rutas de la aplicación")
  Component(auth_ui, "Autenticación", "Guards / Interceptors", "Gestiona login, tokens y acceso a rutas")
  Component(api_client, "Cliente HTTP", "HttpClient", "Consume endpoints del backend")
}

Container_Boundary(backend_boundary, "Contenedor Backend") {
  Component(controllers, "Controllers REST", "Spring MVC", "Expone los endpoints de negocio")
  Component(security, "Seguridad", "Spring Security + JWT", "Autenticación y control de accesos")
  Component(services, "Servicios de dominio", "Spring Services", "Lógica de negocio para personas, clientes, mascotas, reservas y pagos")
  Component(common, "Servicios comunes", "Spring Components", "Email, uploads, excepciones y configuración")
  Component(persistence, "Persistencia", "MyBatis + Mappers", "Acceso a PostgreSQL con mappers XML")
}

System_Ext(db, "PostgreSQL", "Base de datos relacional")
System_Ext(email, "SMTP Gmail", "Envío de correos")
System_Ext(maps, "Google Maps API", "Mapas y geolocalización")
System_Ext(storage, "Almacenamiento local", "Archivos y fotos subidos")

Rel(ui, router, "Usa navegación")
Rel(ui, auth_ui, "Solicita acceso autenticado")
Rel(ui, api_client, "Invoca servicios REST")
Rel(api_client, api, "Consume /api/v1")
Rel(api_client, maps, "Solicita mapas")
Rel(api_client, storage, "Sube archivos")

Rel(controllers, security, "Valida JWT y permisos")
Rel(controllers, services, "Invoca operaciones de negocio")
Rel(services, persistence, "Consulta y almacena datos")
Rel(common, db, "Accede a configuraciones y logs")
Rel(common, email, "Envía correos")
Rel(common, storage, "Guarda archivos")
Rel(persistence, db, "Lee y escribe datos")

@enduml