@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' ============================================================================
' PETCare - Diagrama de componentes (C4 Nivel 3)
' Saga orquestada: reservation + provider + payment coordinados por
' saga-orchestrator (8085) mediante Kafka.
' ============================================================================

title Diagrama de componentes PetCare (Nivel 3) - Saga orquestada

' ---------------------------------------------------------------------------
' Estilos
' ---------------------------------------------------------------------------
UpdateElementStyle(person, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#1168BD")
UpdateElementStyle(container, $fontColor="#5D2C00", $borderColor="#963B00", $bgColor="#FCDE00")
UpdateElementStyle(component, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#D9E2F3")
UpdateElementStyle(database, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#A9D2FF")
UpdateElementStyle(queue, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#F5F5F5")
UpdateElementStyle(external_system, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#E8E8E8")
UpdateElementStyle(boundary, $borderColor="#2F4F4F", $fontColor="#2F4F4F", $bgColor="#F0F0F0")

' ---------------------------------------------------------------------------
' Personas
' ---------------------------------------------------------------------------
Person(cliente, "Cliente", "Crea reservas y paga")
Person(proveedor, "Proveedor", "Responde solicitudes de reserva")

' ---------------------------------------------------------------------------
' Kafka y base de datos (compartidos)
' ---------------------------------------------------------------------------
ContainerQueue(kafka, "Kafka", "Topics", "reserva.creada, reserva.aceptada, reserva.rechazada, reserva.confirmada, reserva.cancelada, pago.completado, pago.fallido, pago.reembolsado, saga.comando.notificar-proveedor, saga.comando.confirmar/rechazar/cancelar-reserva, saga.comando.crear-pago, saga.comando.liberar-descuento, saga.dlt.v1")
ContainerDb(db, "PostgreSQL petcaredb", "PostgreSQL 18", "reserva, pago, solicitud_reserva, saga_estado, evento_procesado, catálogos")

' ---------------------------------------------------------------------------
' saga-orchestrator (Clean Architecture)
' ---------------------------------------------------------------------------
Container_Boundary(sa, "saga-orchestrator (8085)") {
    Component(sa_domain, "domain/model", "POJOs", "Eventos de dominio, comandos de la saga, EstadoSaga, SagaEstado")
    Component(sa_portin, "domain/port/in", "Interfaces", "SagaCoordinator (caso de uso)")
    Component(sa_portout, "domain/port/out", "Interfaces", "SagaEstadoRepository, SagaCommandPublisher, EventoProcesadoRepository")
    Component(sa_app, "application/service", "Spring", "SagaOrquestadorService (máquina de estados), IdempotenciaSagaService")
    Component(sa_in, "infrastructure/adapter/in/kafka", "Kafka listeners", "ReservaEventosListener, PagoEventosListener (ack manual)")
    Component(sa_out, "infrastructure/adapter/out", "Kafka + MyBatis", "KafkaSagaCommandPublisher, MyBatisSagaEstadoRepository, MyBatisEventoProcesadoRepository")
    Component(sa_cfg, "infrastructure/config", "Spring Kafka", "Producer/Consumer/ErrorHandler/TopicConfig (DLT saga.dlt.v1)")

    Rel(sa_in, sa_app, "Delega eventos en el coordinador")
    Rel(sa_app, sa_portin, "Implementa")
    Rel(sa_app, sa_portout, "Usa puertos de salida")
    Rel(sa_portout, sa_out, "Implementado por adapters")
    Rel(sa_out, sa_cfg, "Configurado por")
}

' ---------------------------------------------------------------------------
' reservation-service
' ---------------------------------------------------------------------------
Container_Boundary(rs, "reservation-service (8081)") {
    Component(rs_api, "ReservaController / ReservaService", "Spring MVC + Service", "Crea la reserva (PENDIENTE), confirma, rechaza y compensa")
    Component(rs_consumer, "ConfirmarRechazarCommandConsumer / CancelarReservaCommandConsumer", "Kafka listeners", "Ejecutan los comandos del orquestador con idempotencia")
    Component(rs_pub, "KafkaDomainEventPublisher", "Kafka producer", "Publica ReservaCreadaEvent, ReservaConfirmadaEvent, ReservaCanceladaEvent")
    Component(rs_idem, "IdempotencyService", "MyBatis", "Registra command_id en evento_procesado")

    Rel(rs_api, rs_pub, "Publica eventos de dominio")
    Rel(rs_consumer, rs_api, "Ejecuta el comando")
    Rel(rs_consumer, rs_idem, "Verifica/registra duplicados")
}

' ---------------------------------------------------------------------------
' provider-service
' ---------------------------------------------------------------------------
Container_Boundary(ps, "provider-service (8082)") {
    Component(ps_consumer, "NotificarProveedorCommandConsumer", "Kafka listener", "Recibe el comando y crea las solicitudes PENDIENTE")
    Component(ps_svc, "ProveedorService / ProveedorCrudService / DisponibilidadService / ProveedorServicioService", "Services", "Solicitudes, CRUD de proveedor, disponibilidad y servicios propios")
    Component(ps_pub, "KafkaDomainEventPublisher", "Kafka producer", "Publica ReservaAceptadaEvent, ReservaRechazadaEvent")
    Component(ps_api, "ProveedorController / SolicitudReservaController / DisponibilidadController / ProveedorServicioController", "Spring MVC", "CRUD, disponibilidad, servicios y aceptar/rechazar vía REST")
    Component(ps_promo, "PromocionService + PromocionesController", "Spring MVC + Service", "Promociones propias y globales; expone catálogo /interna para payment")
    Component(ps_interna, "CatalogoInternoController", "Spring MVC", "Endpoints /interna/** para reservation y payment")
    Component(ps_rs, "ReservationInternalClient", "HTTP client", "Consulta vacuna, ubicación y has-reservas a reservation-service")
    Component(ps_idem, "IdempotencyService", "MyBatis", "Registra command_id en evento_procesado")

    Rel(ps_consumer, ps_svc, "Crea solicitudes")
    Rel(ps_api, ps_svc, "Acepta / rechaza y gestiona catálogo")
    Rel(ps_svc, ps_pub, "Publica eventos de aceptación/rechazo")
    Rel(ps_svc, ps_rs, "Valida datos contra reservation-service")
    Rel(ps_consumer, ps_idem, "Verifica/registra duplicados")
}

' ---------------------------------------------------------------------------
' payment-service
' ---------------------------------------------------------------------------
Container_Boundary(ms, "payment-service (8083)") {
    Component(ms_consumer, "CrearPagoCommandConsumer", "Kafka listener", "Recibe el comando y crea el pago (PENDIENTE)")
    Component(ms_lib, "LiberarDescuentoCommandConsumer", "Kafka listener", "Revierte el cupo de la promoción por compensación")
    Component(ms_svc, "PagoService / PagoServiceImpl", "Service", "Crea, procesa y reembolsa pagos; aplica descuentos")
    Component(ms_pub, "KafkaDomainEventPublisher", "Kafka producer", "Publica PagoProcesadoEvent, PagoFallidoEvent, PagoReembolsadoEvent")
    Component(ms_idem, "IdempotencyService", "MyBatis", "Registra command_id en evento_procesado")

    Rel(ms_consumer, ms_svc, "Crea el pago")
    Rel(ms_consumer, ms_idem, "Verifica/registra duplicados")
    Rel(ms_svc, ms_pasarela, "Procesa el pago")
    Rel(ms_svc, ms_pub, "Publica el resultado del pago")
}

' ---------------------------------------------------------------------------
' Flujos de la saga
' ---------------------------------------------------------------------------
Rel(cliente, rs_api, "1. Crea la reserva (PENDIENTE)", "REST /reservas")
Rel(rs_api, rs_pub, "Publica el evento creada")
Rel(rs_pub, kafka, "2. ReservaCreadaEvent", "reserva.creada")
Rel(kafka, sa_in, "3. Consume el evento", "reserva.creada")
Rel(sa_app, sa_out, "4. Ordena notificar al proveedor")
Rel(sa_out, kafka, "5. NotificarProveedorCommand", "saga.comando.notificar-proveedor")
Rel(kafka, ps_consumer, "6. Consume el comando", "saga.comando.notificar-proveedor")
Rel(ps_consumer, ps_svc, "Crea solicitudes PENDIENTE")
Rel(proveedor, ps_api, "7. Acepta / rechaza la solicitud", "REST")
Rel(ps_pub, kafka, "8. ReservaAceptadaEvent / ReservaRechazadaEvent", "reserva.aceptada / reserva.rechazada")
Rel(kafka, sa_in, "9. Consume el evento", "reserva.aceptada / reserva.rechazada")
Rel(sa_out, kafka, "10. Confirmar/RechazarReservaCommand", "saga.comando.confirmar/rechazar-reserva")
Rel(kafka, rs_consumer, "11. Consume el comando", "saga.comando.confirmar/rechazar-reserva")
Rel(rs_pub, kafka, "12. ReservaConfirmadaEvent", "reserva.confirmada")
Rel(kafka, sa_in, "13. Consume el evento", "reserva.confirmada")
Rel(sa_out, kafka, "14. CrearPagoCommand", "saga.comando.crear-pago")
Rel(kafka, ms_consumer, "15. Consume el comando", "saga.comando.crear-pago")
Rel(ms_svc, ms_pasarela, "16. Procesa el pago")
Rel(ms_pub, kafka, "17. PagoProcesadoEvent / PagoFallidoEvent", "pago.completado / pago.fallido")
Rel(kafka, sa_in, "18. Consume el resultado", "pago.*")

' ---------------------------------------------------------------------------
' Compensación centralizada
' ---------------------------------------------------------------------------
Rel(sa_out, kafka, "19. CancelarReservaCommand (si pago fallido)", "saga.comando.cancelar-reserva")
Rel(kafka, rs_consumer, "20. Consume el comando de compensación", "saga.comando.cancelar-reserva")
Rel(rs_pub, kafka, "21. ReservaCanceladaEvent", "reserva.cancelada")
Rel(sa_out, kafka, "22. LiberarDescuentoCommand (si pago fallido/reembolsado)", "saga.comando.liberar-descuento")
Rel(kafka, ms_lib, "23. Revierte el cupo de la promoción", "saga.comando.liberar-descuento")

' ---------------------------------------------------------------------------
' REST entre microservicios (catálogo interno)
' ---------------------------------------------------------------------------
Rel(rs_api, ps_interna, "Obtiene proveedor, servicio, modalidades y disponibilidad", "HTTP /interna/**")
Rel(ps_rs, rs_api, "Obtiene vacuna, ubicación y has-reservas", "HTTP /interna/**")
Rel(ms_svc, ps_interna, "Obtiene promoción activa, usos y costo adicional", "HTTP /interna/**")

' ---------------------------------------------------------------------------
' Persistencia
' ---------------------------------------------------------------------------
Rel(sa_out, db, "Persiste saga_estado + evento_procesado", "JDBC / MyBatis")
Rel(rs_api, db, "Persiste reserva y notificaciones", "JDBC / MyBatis")
Rel(ps_svc, db, "Persiste proveedor, solicitud_reserva, disponibilidad y promociones", "JDBC / MyBatis")
Rel(ms_svc, db, "Persiste pago (con descuentos)", "JDBC / MyBatis")

note bottom of sa_app
  Máquina de estados por reserva (tabla saga_estado):
  INICIADA -> PROVEEDOR_NOTIFICADO -> RESERVA_ACEPTADA ->
  RESERVA_CONFIRMADA -> PAGO_SOLICITADO -> COMPLETADA.
  Fallos: PAGO_FALLIDO -> CancelarReservaCommand -> CANCELADA;
  rechazo del proveedor -> RECHAZADA; reembolso -> PAGO_REEMBOLSADO.
end note

note bottom of kafka
  Idempotencia: los consumidores registran event_id / command_id en
  evento_procesado y los duplicados se ignoran. Ack manual
  (MANUAL_IMMEDIATE); fallos no recuperables van al DLT saga.dlt.v1.
end note

LAYOUT_WITH_LEGEND()

@enduml
