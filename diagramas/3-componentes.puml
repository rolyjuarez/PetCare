@startuml
skinparam rectangle {
    BackgroundColor #F7F7F7
    BorderColor #333333
}
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #2F4F4F
}
skinparam note {
    BackgroundColor #FFF8E1
    BorderColor #CFA13B
}

title Diagrama de componentes de PetCare

actor Cliente as Usuario
actor Administrador as Admin
actor Proveedor as Proveedor

rectangle "Frontend Angular" as Frontend {
    component "UI / SPA" as UI
    note right of UI
        - Navegación del usuario
        - Formularios de login, registro,
        gestión de mascotas, reservas y pagos
        - Carga de fotos de mascotas
    end note
}

rectangle "Backend Spring Boot" as Backend {
    component "REST API Controllers" as Controllers
    component "Autenticación y JWT" as Auth
    component "Servicios de dominio" as DomainServices
    component "Servicios comunes" as CommonServices
    component "MyBatis / Mappers" as Persistence
    component "Seguridad / Configuración" as Security
    note right of Backend
        - Estructura basada en capas
        - Controladores REST expuestos en /app/
        - Lógica de negocio en servicios
        - Persistencia por MyBatis con mappers XML
        - Seguridad stateless con JWT
    end note
}

database "PostgreSQL" as Database
storage "Almacenamiento de archivos" as FileStorage
cloud "Proveedor SMTP (Gmail)" as EmailService
cloud "Google Maps API" as MapsAPI

Usuario --> UI : Usa la aplicación
Admin --> UI : Administra la plataforma
Proveedor --> UI : Presta servicios
UI --> Controllers : Llama a endpoints REST
Controllers --> Auth : Valida credenciales y tokens
Controllers --> DomainServices : Solicita operaciones de negocio
Controllers --> CommonServices : Subida de archivos, emails
DomainServices --> Persistence : Consulta y guarda datos
CommonServices --> Database : Accede a configuraciones / logs
CommonServices --> FileStorage : Guarda fotos de mascotas
CommonServices --> EmailService : Envía correos de registro / recuperación
UI --> MapsAPI : Solicita geolocalización y mapas

note left of Auth
    - AuthController
    - JwtTokenProvider
    - JwtAuthenticationFilter
    - UserDetailsServiceImpl
end note

note left of DomainServices
    - PersonaService
    - ClienteService
    - MascotaService
    - ReservaService
    - PagoService
    - ProveedorService
    - Notificación y catálogo
end note

note left of CommonServices
    - UploadService
    - EmailService
    - GlobalExceptionHandler
    - Cache / Async config
end note

note left of Persistence
    - MyBatis mappers para cada entidad
    - MapperScan en PetCareApplication
    - XML de consultas en /mapper
end note

@enduml