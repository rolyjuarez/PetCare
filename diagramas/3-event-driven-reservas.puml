@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ============================================================================
' PETCare - Saga coreografiada de Reservas (rama sesion-5-saga-pattern)
' ============================================================================

title Saga coreografiada de Reservas - PETCare

' ---------------------------------------------------------------------------
' Estilos
' ---------------------------------------------------------------------------
UpdateElementStyle(person, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#1168BD")
UpdateElementStyle(container, $fontColor="#5D2C00", $borderColor="#963B00", $bgColor="#FCDE00")
UpdateElementStyle(system, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#E8E8E8")
UpdateElementStyle(boundary, $borderColor="#2F4F4F", $fontColor="#2F4F4F", $bgColor="#F0F0F0")

' ---------------------------------------------------------------------------
' Personas
' ---------------------------------------------------------------------------
Person(cliente, "Cliente", "Crea y da seguimiento a sus reservas")
Person(proveedor, "Proveedor", "Acepta o rechaza las solicitudes de reserva")

' ---------------------------------------------------------------------------
' Servicios de la saga
' ---------------------------------------------------------------------------
System_Ext(rs, "reservation-service", "Spring Boot 8081", "Dueño de la reserva: crea, confirma y compensa")
System_Ext(ps, "provider-service", "Spring Boot 8082", "Crea solicitudes y responde aceptación/rechazo")
System_Ext(ms, "payment-service", "Spring Boot 8083", "Crea y procesa el pago; dispara la compensación si falla")

' ---------------------------------------------------------------------------
' Tópicos Kafka (evento por tópico, con productor y consumidor)
' ---------------------------------------------------------------------------
ContainerQueue(creada, "reserva.creada", "ReservaCreadaEvent", "Producer: reservation-service | Consumer: provider-service")
ContainerQueue(aceptada, "reserva.aceptada", "ReservaAceptadaEvent", "Producer: provider-service | Consumer: reservation-service")
ContainerQueue(rechazada, "reserva.rechazada", "ReservaRechazadaEvent", "Producer: provider-service | Consumer: reservation-service")
ContainerQueue(confirmada, "reserva.confirmada", "ReservaConfirmadaEvent", "Producer: reservation-service | Consumer: payment-service")
ContainerQueue(fallido, "pago.fallido", "PagoFallidoEvent", "Producer: payment-service | Consumer: reservation-service")
ContainerQueue(cancelada, "reserva.cancelada", "ReservaCanceladaEvent", "Producer: reservation-service | Consumer: (ninguno)")
ContainerQueue(dlt, "reserva.dlt.v1", "Dead-letter", "Eventos que fallan tras el retry")

ContainerDb(db, "PostgreSQL petcaredb", "PostgreSQL 18", "Tablas reserva, solicitud_reserva, pago, evento_procesado")

' ---------------------------------------------------------------------------
' Flujo feliz
' ---------------------------------------------------------------------------
Rel(cliente, rs, "1. Crea la reserva (PENDIENTE)", "REST /reservas")
Rel(rs, creada, "2. Publica ReservaCreadaEvent", "Kafka")
Rel(creada, ps, "3. Consume y crea solicitud PENDIENTE", "Kafka")
Rel(proveedor, ps, "4. Acepta / rechaza la solicitud", "REST /aceptar /rechazar")
Rel(ps, aceptada, "5a. Publica ReservaAceptadaEvent", "Kafka")
Rel(ps, rechazada, "5b. Publica ReservaRechazadaEvent", "Kafka")
Rel(aceptada, rs, "6a. Reserva pasa a CONFIRMADA", "Kafka")
Rel(rechazada, rs, "6b. Reserva pasa a RECHAZADA", "Kafka")
Rel(rs, confirmada, "7. Publica ReservaConfirmadaEvent", "Kafka")
Rel(confirmada, ms, "8. Consume y crea el pago (PENDIENTE)", "Kafka")
Rel(ms, db, "Persiste pago; rs persiste reserva", "JDBC")

' ---------------------------------------------------------------------------
' Compensación: pago fallido
' ---------------------------------------------------------------------------
Rel(ms, fallido, "9. Publica PagoFallidoEvent (pasarela rechaza)", "Kafka")
Rel(fallido, rs, "10. Consume y compensa: reserva CANCELADA", "Kafka")
Rel(rs, cancelada, "11. Publica ReservaCanceladaEvent", "Kafka")

note bottom of confirmada
    {|
    |= Evento |= Topic |= Productor |= Consumidor |
    | ReservaCreadaEvent | reserva.creada | reservation-service | provider-service |
    | ReservaAceptadaEvent | reserva.aceptada | provider-service | reservation-service |
    | ReservaRechazadaEvent | reserva.rechazada | provider-service | reservation-service |
    | ReservaConfirmadaEvent | reserva.confirmada | reservation-service | payment-service |
    | PagoFallidoEvent | pago.fallido | payment-service | reservation-service |
    | ReservaCanceladaEvent | reserva.cancelada | reservation-service | (ninguno) |
    |}
end note

note bottom of dlt
    Saga coreografiada (sin orquestador): cada servicio publica y consume
    eventos y compensa su propia transacción local. Consumidores con ack
    manual e idempotencia (evento_procesado); fallos van a reserva.dlt.v1.
end note

LAYOUT_WITH_LEGEND()

@enduml
