@startuml
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2F4F4F
}
skinparam cloud {
  BackgroundColor #E8F7E0
  BorderColor #4A7C59
}

Title Diagrama de contenedores de PetCare

actor Cliente as Cliente
actor Administrador as Administrador
actor Proveedor as Proveedor

rectangle "Frontend" as Frontend {
  component "Angular SPA" as SPA
  note right of SPA
    - Interfaz del usuario
    - Consume la API REST
    - Valida formularios y carga de fotos
  end note
}

rectangle "Monolito Backend" as Monolith {
  component "API REST / Controladores" as Api
  component "Módulo auth" as AuthModule
  component "Módulo persona" as PersonaModule
  component "Módulo cliente" as ClienteModule
  component "Módulo usuario" as UsuarioModule
  component "Módulo mascota" as MascotaModule
  component "Módulo direccion" as DireccionModule
  component "Módulo proveedor" as ProveedorModule
  component "Módulo reserva" as ReservaModule
  component "Módulo pago" as PagoModule
  component "Módulo promocion" as PromocionModule
  component "Módulo notificacion" as NotificacionModule
  component "Módulo rol/menu" as MenuRolModule
  component "Módulo sucursal" as SucursalModule
  component "Módulo bitacora" as BitacoraModule
  component "Infraestructura" as InfraModule
  note right of Monolith
    - Spring Boot monolítico con paquetes por dominio
    - Backend organizado como módulos dentro del mismo proceso
    - Cada módulo expone controladores, servicios y mappers
    - Persistencia con MyBatis + XML mappers
  end note
}

database "PostgreSQL" as Database
storage "Uploads locales" as FileStorage
cloud "SMTP Gmail" as EmailService
cloud "Google Maps API" as MapsAPI

Cliente --> SPA : Usa la aplicación web
Administrador --> SPA : Administra recursos
Proveedor --> SPA : Publica y administra servicios
SPA --> Api : Consume endpoints REST

Api --> AuthModule : Login / JWT / registro / recuperación
Api --> PersonaModule : /api/v1/personas
Api --> ClienteModule : /api/v1/clientes
Api --> UsuarioModule : /api/v1/usuarios
Api --> MascotaModule : /api/v1/mascotas, especies, razas
Api --> DireccionModule : /api/v1/direcciones, /api/v1/ciudades
Api --> ProveedorModule : /api/v1/proveedores, /api/v1/disponibilidades
Api --> ReservaModule : /api/v1/reservas
Api --> PagoModule : /api/v1/pagos
Api --> PromocionModule : /api/v1/promociones
Api --> NotificacionModule : /api/v1/notificaciones
Api --> MenuRolModule : /api/v1/menus, /api/v1/permisos, /api/v1/roles
Api --> SucursalModule : /api/v1/sucursales
Api --> BitacoraModule : /api/v1/bitacoras
Api --> InfraModule : Uploads, emails, seguridad, configuración

AuthModule --> Database : Credenciales / usuarios
PersonaModule --> Database : Personas
ClienteModule --> Database : Clientes
UsuarioModule --> Database : Usuarios
MascotaModule --> Database : Mascotas, especies, razas
DireccionModule --> Database : Direcciones, ciudades, estados
ProveedorModule --> Database : Proveedores, especialidades, disponibilidades
ReservaModule --> Database : Reservas, estado de reservas
PagoModule --> Database : Pagos
PromocionModule --> Database : Promociones, promociones locales
NotificacionModule --> Database : Notificaciones
MenuRolModule --> Database : Menús, permisos, roles
SucursalModule --> Database : Sucursales
BitacoraModule --> Database : Bitácora de acciones
InfraModule --> Database : Configuraciones, logs
InfraModule --> FileStorage : Guarda fotos y archivos de mascotas
InfraModule --> EmailService : Envío de correos
SPA --> MapsAPI : Solicita mapas y geolocalización

