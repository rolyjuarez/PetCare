@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ============================================================================
' PETCare - Vista de contenedores (Nivel 2 C4)
' ============================================================================

title Vista de contenedores - PETCare

' ---------------------------------------------------------------------------
' Estilos
' ---------------------------------------------------------------------------
UpdateElementStyle(person, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#1168BD")
UpdateElementStyle(container, $fontColor="#5D2C00", $borderColor="#963B00", $bgColor="#FCDE00")
UpdateElementStyle(system, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#E8E8E8")
UpdateElementStyle(boundary, $borderColor="#2F4F4F", $fontColor="#2F4F4F", $bgColor="#F0F0F0")

' ---------------------------------------------------------------------------
' Personas
' ---------------------------------------------------------------------------
Person(cliente, "Cliente", "Reserva y paga servicios para sus mascotas")
Person(proveedor, "Proveedor", "Ofrece servicios y responde solicitudes")
Person(admin, "Administrador", "Gestiona el sistema")

' ---------------------------------------------------------------------------
' Límite de la plataforma
' ---------------------------------------------------------------------------
System_Boundary(petcare, "PETCare", "Plataforma de servicios para mascotas") {

    ' --- Frontend ---
    Container(frontend, "Frontend Angular", "Angular 21 + Tailwind CSS", "SPA: módulos de cliente, proveedor, admin; se ejecuta en puerto 4200 (dev) o 80 (docker)")

    ' --- Backend monolito (API gateway) ---
    Container(backend, "Backend monolito", "Spring Boot 3.4.1", "API REST /api/v1; auth JWT, catálogos, uploads, correos y proxy hacia microservicios", $tags="gw")

    ' --- Microservicios ---
    Container(rs, "reservation-service", "Spring Boot 3.4.1", "Reservas, slots y disponibilidad (8081)", $tags="ms")
    Container(ps, "provider-service", "Spring Boot 3.4.1", "Solicitudes de reserva del proveedor (8082)", $tags="ms")
    Container(ms, "payment-service", "Spring Boot 3.4.1", "Pagos, descuentos y reembolsos (8083)", $tags="ms")

    ' --- Mensajería ---
    ContainerQueue(kafka, "Kafka + Zookeeper", "Apache Kafka 3.8", "Tópicos: reserva.creada, reserva.aceptada, reserva.rechazada, reserva.confirmada, pago.completado, reserva.dlt.v1")

    ' --- Persistencia ---
    ContainerDb(db, "PostgreSQL petcaredb", "PostgreSQL 18", "Base única compartida por backend y microservicios (5432)")
}

' ---------------------------------------------------------------------------
' Sistemas externos
' ---------------------------------------------------------------------------
System_Ext(pasarela, "Pasarela de pago", "Proveedor externo de pagos (simulado en dev)")
System_Ext(smtp, "Servicio SMTP", "Correos transaccionales")
System_Ext(gmaps, "Google Maps API", "Mapas y geocodificación")

' ---------------------------------------------------------------------------
' Relaciones de usuarios
' ---------------------------------------------------------------------------
Rel(cliente, frontend, "Agenda, paga y administra mascotas", "HTTPS")
Rel(proveedor, frontend, "Gestiona servicios y solicitudes", "HTTPS")
Rel(admin, frontend, "Administra el sistema", "HTTPS")

' ---------------------------------------------------------------------------
' Flujo REST (frontend -> backend -> microservicios)
' ---------------------------------------------------------------------------
Rel(frontend, backend, "Consume API REST", "HTTPS /api/v1")
Rel(backend, rs, "Proxy de reservas", "HTTP /api/v1/reservas/*")
Rel(backend, ps, "Proxy de solicitudes", "HTTP /api/v1/proveedor/*")
Rel(backend, ms, "Proxy de pagos", "HTTP /api/v1/pagos/*")

' ---------------------------------------------------------------------------
' Flujo de eventos Kafka
' ---------------------------------------------------------------------------
Rel(rs, kafka, "Publica ReservaCreada / ReservaConfirmada", "reserva.creada / reserva.confirmada")
Rel(ps, kafka, "Consume ReservaCreada; publica Aceptada/Rechazada", "reserva.creada / reserva.aceptada / reserva.rechazada")
Rel(ms, kafka, "Consume ReservaConfirmada; publica PagoProcesado", "reserva.confirmada / pago.completado")
Rel(rs, kafka, "Consume Aceptada/Rechazada", "reserva.aceptada / reserva.rechazada")

' ---------------------------------------------------------------------------
' Persistencia
' ---------------------------------------------------------------------------
Rel(backend, db, "Catálogos, usuarios, notificaciones", "JDBC")
Rel(rs, db, "Reservas, disponibilidad, estados", "JDBC")
Rel(ps, db, "Solicitudes, proveedores, vacunas", "JDBC")
Rel(ms, db, "Pagos y reembolsos", "JDBC")

' ---------------------------------------------------------------------------
' Externos y observabilidad
' ---------------------------------------------------------------------------
Rel(ms, pasarela, "Procesa/reembolsa pagos", "REST/HTTPS")
Rel(backend, smtp, "Envía correos", "SMTP")
Rel(rs, smtp, "Confirma/rechaza por correo", "SMTP")
Rel(frontend, gmaps, "Mapas y coordenadas", "HTTPS")


' ---------------------------------------------------------------------------
' Nota general
' ---------------------------------------------------------------------------
note bottom of petcare
    Los microservicios no se llaman por REST entre sí: se comunican mediante
    eventos asíncronos en Kafka. El backend monolito conserva el CRUD y la
    autenticación, y actúa como API gateway para las rutas delegadas.
end note

LAYOUT_WITH_LEGEND()

@enduml
