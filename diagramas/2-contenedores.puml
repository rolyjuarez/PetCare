@startuml
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam database {
  BackgroundColor #E8F0FE
  BorderColor #336699
}
skinparam cloud {
  BackgroundColor #FFF5E1
  BorderColor #CFA13B
}

Title Diagrama de contenedores de PetCare

actor Cliente as Cliente
actor Administrador as Administrador
actor Proveedor as "Proveedor de servicios veterinarios"

rectangle "Navegador Web" as Browser {
  rectangle "Angular SPA" as Frontend
}

rectangle "PetCare Backend" as Backend {
  rectangle "Spring Boot REST API" as Api
  note right of Api
    • Endpoints: /app/auth, /app/personas,
      /app/clientes, /app/mascotas,
      /app/reservas, /app/pagos, /app/uploads
    • Seguridad JWT + filtros de Spring Security
    • Lógica de negocio en servicios
    • MyBatis + mappers para persistencia
  end note
}

database "PostgreSQL" as Database
rectangle "Storage local de archivos" as FileStorage
cloud "Proveedor SMTP (Gmail)" as EmailService
cloud "Google Maps API" as MapsAPI

Cliente --> Frontend : Usa la app web
Administrador --> Frontend : Accede al sistema de administración
Proveedor --> Frontend : Presta servicios
Frontend --> Api : Consume API REST
Api --> Database : Lee/escribe datos del sistema
Api --> FileStorage : Guarda fotos de mascotas
Api --> EmailService : Envía correos de registro, recuperación de contraseña y notificaciones
Frontend --> MapsAPI : Solicita mapas y geolocalización

@enduml