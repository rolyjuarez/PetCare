@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ============================================================================
' PETCare - Diagrama de contenedores (C4 Nivel 2)
' ============================================================================

title Diagrama de contenedores PetCare (Nivel 2)

' ---------------------------------------------------------------------------
' Estilos
' ---------------------------------------------------------------------------
UpdateElementStyle(person, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#1168BD")
UpdateElementStyle(container, $fontColor="#5D2C00", $borderColor="#963B00", $bgColor="#FCDE00")
UpdateElementStyle(database, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#A9D2FF")
UpdateElementStyle(queue, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#D9E2F3")
UpdateElementStyle(external_system, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#E8E8E8")
UpdateElementStyle(boundary, $borderColor="#2F4F4F", $fontColor="#2F4F4F", $bgColor="#F0F0F0")

' ---------------------------------------------------------------------------
' Personas
' ---------------------------------------------------------------------------
Person(cliente, "Cliente", "Agenda, paga y da seguimiento a sus reservas")
Person(proveedor, "Proveedor", "Publica servicios y responde solicitudes de reserva")

' ---------------------------------------------------------------------------
' Contenedores
' ---------------------------------------------------------------------------
System_Boundary(petcare, "PetCare") {

    Container(frontend, "Frontend", "Angular SPA (Nginx)", "Interfaz web para clientes, proveedores y administradores")

    Container(backend, "backend", "Spring Boot 8080", "API REST /api/v1, auth JWT, catálogos, promociones, notificaciones")

    Container(rs, "reservation-service", "Spring Boot 8081", "Dueño de la reserva: crea, confirma, rechaza y compensa")
    Container(ps, "provider-service", "Spring Boot 8082", "Crea solicitudes de reserva y responde aceptación/rechazo")
    Container(ms, "payment-service", "Spring Boot 8083", "Crea, procesa y reembolsa pagos")
    Container(sa, "saga-orchestrator", "Spring Boot 8085", "Orquesta la saga: máquina de estados y compensación centralizada")

    ContainerDb(db, "PostgreSQL petcaredb", "PostgreSQL 18", "Base compartida: reserva, pago, solicitud_reserva, evento_procesado, saga_estado, catálogos")
    ContainerQueue(kafka, "Kafka", "Confluent 7.7", "Topics de dominio (reserva.*, pago.*) y de comandos (saga.comando.*), DLT saga.dlt.v1")
}

' ---------------------------------------------------------------------------
' Sistemas externos
' ---------------------------------------------------------------------------
System_Ext(pasarela, "Pasarela de pago", "Procesa los pagos (simulada en dev)")
System_Ext(smtp, "SMTP Gmail", "Correos transaccionales")
System_Ext(maps, "Google Maps API", "Mapas y geolocalización")

System_Ext(pgadmin, "pgAdmin", "Administración de la base de datos")

' ---------------------------------------------------------------------------
' Relaciones de usuario y frontend
' ---------------------------------------------------------------------------
Rel(cliente, frontend, "Usa la aplicación web", "HTTPS")
Rel(proveedor, frontend, "Publica servicios y responde reservas", "HTTPS")
Rel(frontend, backend, "Consume API REST", "HTTP /api/v1")
Rel(frontend, rs, "Crea y consulta reservas", "HTTP")
Rel(frontend, ps, "Responde solicitudes de reserva", "HTTP")

' ---------------------------------------------------------------------------
' Backend -> microservicios
' ---------------------------------------------------------------------------
Rel(backend, rs, "Llama al microservicio de reservas", "HTTP")
Rel(backend, ps, "Llama al microservicio de proveedores", "HTTP")

' ---------------------------------------------------------------------------
' Saga: Kafka (eventos y comandos)
' ---------------------------------------------------------------------------
Rel(rs, kafka, "Publica reserva.creada, reserva.confirmada, reserva.cancelada", "Kafka")
Rel(rs, kafka, "Consume saga.comando.confirmar/rechazar/cancelar-reserva", "Kafka")
Rel(ps, kafka, "Publica reserva.aceptada, reserva.rechazada", "Kafka")
Rel(ps, kafka, "Consume saga.comando.notificar-proveedor", "Kafka")
Rel(ms, kafka, "Publica pago.completado, pago.fallido, pago.reembolsado", "Kafka")
Rel(ms, kafka, "Consume saga.comando.crear-pago", "Kafka")
Rel(sa, kafka, "Consume los eventos de dominio y publica los comandos de la saga", "Kafka")

' ---------------------------------------------------------------------------
' Persistencia
' ---------------------------------------------------------------------------
Rel(sa, db, "Persiste saga_estado y evento_procesado", "JDBC / MyBatis")
Rel(rs, db, "Persiste reserva y notificacion", "JDBC / MyBatis")
Rel(ps, db, "Persiste solicitud_reserva", "JDBC / MyBatis")
Rel(ms, db, "Persiste pago", "JDBC / MyBatis")
Rel(backend, db, "Persiste catálogos, usuarios y promociones", "JDBC / MyBatis")

' ---------------------------------------------------------------------------
' Externos
' ---------------------------------------------------------------------------
Rel(ms, pasarela, "Procesa / reembolsa el pago", "REST/HTTPS")
Rel(backend, smtp, "Envía correos transaccionales", "SMTP")
Rel(frontend, maps, "Mapas y geolocalización", "HTTPS")


Rel(pgadmin, db, "Administra la base de datos", "JDBC")

note bottom of sa
  Clean Architecture: domain (model + ports), application
  (SagaOrquestadorService, IdempotenciaSagaService) e
  infrastructure (listeners Kafka, publisher de comandos,
  mappers MyBatis de saga_estado y evento_procesado).
end note

LAYOUT_WITH_LEGEND()

@enduml
