@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ============================================================================
' PETCare - Flujo event-driven del módulo de Pagos
' ============================================================================

title Event-driven de Pagos - PETCare

' ---------------------------------------------------------------------------
' Estilos
' ---------------------------------------------------------------------------
UpdateElementStyle(person, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#1168BD")
UpdateElementStyle(container, $fontColor="#5D2C00", $borderColor="#963B00", $bgColor="#FCDE00")
UpdateElementStyle(system, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#E8E8E8")
UpdateElementStyle(boundary, $borderColor="#2F4F4F", $fontColor="#2F4F4F", $bgColor="#F0F0F0")

' ---------------------------------------------------------------------------
' Personas
' ---------------------------------------------------------------------------
Person(cliente, "Cliente", "Paga y consulta el historial de sus reservas")

' ---------------------------------------------------------------------------
' Servicios
' ---------------------------------------------------------------------------
System_Ext(rs, "reservation-service", "Spring Boot 8081", "Publica la reserva confirmada")
System_Ext(ms, "payment-service", "Spring Boot 8083", "Crea, procesa y reembolsa pagos; aplica la cadena de descuentos")

' ---------------------------------------------------------------------------
' Tópicos Kafka
' ---------------------------------------------------------------------------
ContainerQueue(confirmada, "reserva.confirmada", "ReservaConfirmadaEvent", "Producer: reservation-service | Consumer: payment-service")
ContainerQueue(completado, "pago.completado", "PagoProcesadoEvent", "Producer: payment-service | Consumer: (ninguno)")

ContainerDb(db, "PostgreSQL petcaredb", "PostgreSQL 18", "Tablas pago, promoción, descuento")
System_Ext(pasarela, "Pasarela de pago", "Proveedor externo de pagos", "Simulada en dev por SimulatedPaymentGateway")

' ---------------------------------------------------------------------------
' Flujo de eventos
' ---------------------------------------------------------------------------
Rel(rs, confirmada, "1. Publica ReservaConfirmadaEvent", "Kafka")
Rel(confirmada, ms, "2. Consume y crea el pago", "Kafka")
Rel(ms, db, "3. Persiste el pago", "JDBC")
Rel(ms, pasarela, "4. Procesa / reembolsa", "REST/HTTPS")
Rel(ms, completado, "5. Publica PagoProcesadoEvent", "Kafka")
Rel(cliente, ms, "Consulta historial de pagos", "REST /pagos")

note bottom of completado
    {|
    |= Evento |= Topic |= Productor |= Consumidor |
    | ReservaConfirmadaEvent | reserva.confirmada | reservation-service | payment-service |
    | PagoProcesadoEvent | pago.completado | payment-service | (ninguno) |
    |}

    pago.completado no tiene consumidor todavía: un futuro servicio de
    notificaciones o reportes puede suscribirse para avisar al cliente.
end note

LAYOUT_WITH_LEGEND()

@enduml
