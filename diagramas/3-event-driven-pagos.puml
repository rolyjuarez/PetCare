@startuml
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #444444
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2F4F4F
}
skinparam database {
  BackgroundColor #EAF4FF
  BorderColor #2B6CB0
}
skinparam queue {
  BackgroundColor #FDECEC
  BorderColor #C53030
}

title Event-Driven - Módulo de Pagos

component "PagoService" as PagoService
component "PagoRepository / Mapper" as PagoRepo
component "ReservaApi" as ReservaApi
component "ClienteApi" as ClienteApi
component "PersonaApi" as PersonaApi
component "DomainEventPublisher" as EventPublisher
component "OutboxPublisher" as Outbox
component "KafkaDomainEventPublisher" as KafkaPublisher
component "Kafka Topics" as Kafka
component "PagoEventConsumer" as PagoConsumer
component "NotificacionApi" as NotificacionApi
component "PostgreSQL" as Database

PagoService --> PagoRepo : persiste pago
PagoService --> ReservaApi : consulta reserva
PagoService --> ClienteApi : consulta cliente
PagoService --> PersonaApi : consulta datos de persona

PagoService --> EventPublisher : publica PagoConfirmadoEvent / PagoReembolsadoEvent

EventPublisher --> KafkaPublisher : modo kafka
KafkaPublisher --> Outbox : registra evento
Outbox --> Kafka : petcare.pago.event.v1
Kafka --> PagoConsumer : consume eventos
PagoConsumer --> NotificacionApi : crea notificación
NotificacionApi --> Database : inserta notificación
PagoRepo --> Database : guarda estado del pago

note right of PagoService
  Al confirmar o reembolsar un pago
  se emite un evento de dominio.
end note

note bottom of Outbox
  Patrón outbox para asegurar
  la publicación confiable del evento.
end note
@enduml
