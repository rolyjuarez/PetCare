@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ============================================================================
' PETCare - Saga coreografiada de Pagos (rama sesion-5-saga-pattern)
' ============================================================================

title Saga coreografiada de Pagos - PETCare

' ---------------------------------------------------------------------------
' Estilos
' ---------------------------------------------------------------------------
UpdateElementStyle(person, $fontColor="#08427B", $borderColor="#052F61", $bgColor="#1168BD")
UpdateElementStyle(container, $fontColor="#5D2C00", $borderColor="#963B00", $bgColor="#FCDE00")
UpdateElementStyle(system, $fontColor="#1168BD", $borderColor="#052F61", $bgColor="#E8E8E8")
UpdateElementStyle(boundary, $borderColor="#2F4F4F", $fontColor="#2F4F4F", $bgColor="#F0F0F0")

' ---------------------------------------------------------------------------
' Personas
' ---------------------------------------------------------------------------
Person(cliente, "Cliente", "Paga y consulta el historial de sus reservas")

' ---------------------------------------------------------------------------
' Servicios de la saga
' ---------------------------------------------------------------------------
System_Ext(rs, "reservation-service", "Spring Boot 8081", "Publica la reserva confirmada y compensa si el pago falla")
System_Ext(ms, "payment-service", "Spring Boot 8083", "Crea, procesa y reembolsa pagos; publica el resultado")

' ---------------------------------------------------------------------------
' Tópicos Kafka (evento por tópico, con productor y consumidor)
' ---------------------------------------------------------------------------
ContainerQueue(confirmada, "reserva.confirmada", "ReservaConfirmadaEvent", "Producer: reservation-service | Consumer: payment-service")
ContainerQueue(completado, "pago.completado", "PagoProcesadoEvent", "Producer: payment-service | Consumer: (ninguno)")
ContainerQueue(fallido, "pago.fallido", "PagoFallidoEvent", "Producer: payment-service | Consumer: reservation-service")
ContainerQueue(reembolsado, "pago.reembolsado", "PagoReembolsadoEvent", "Producer: payment-service | Consumer: (ninguno)")

ContainerDb(db, "PostgreSQL petcaredb", "PostgreSQL 18", "Tablas pago, reserva, evento_procesado")
System_Ext(pasarela, "Pasarela de pago", "Proveedor externo de pagos", "Simulada en dev")

' ---------------------------------------------------------------------------
' Flujo feliz
' ---------------------------------------------------------------------------
Rel(rs, confirmada, "1. Publica ReservaConfirmadaEvent", "Kafka")
Rel(confirmada, ms, "2. Consume y crea el pago (PENDIENTE)", "Kafka")
Rel(ms, db, "3. Persiste el pago", "JDBC")
Rel(ms, pasarela, "4. procesar() vía pasarela", "REST/HTTPS")
Rel(ms, completado, "5a. Publica PagoProcesadoEvent (COMPLETADO)", "Kafka")
Rel(ms, reembolsado, "5b. Publica PagoReembolsadoEvent (si se reembolsa)", "Kafka")

' ---------------------------------------------------------------------------
' Compensación: pago fallido
' ---------------------------------------------------------------------------
Rel(ms, fallido, "4b. Publica PagoFallidoEvent (pasarela rechaza)", "Kafka")
Rel(fallido, rs, "5c. Consume y cancela la reserva (CANCELADA)", "Kafka")

note bottom of completado
    {|
    |= Evento |= Topic |= Productor |= Consumidor |
    | ReservaConfirmadaEvent | reserva.confirmada | reservation-service | payment-service |
    | PagoProcesadoEvent | pago.completado | payment-service | (ninguno) |
    | PagoFallidoEvent | pago.fallido | payment-service | reservation-service |
    | PagoReembolsadoEvent | pago.reembolsado | payment-service | (ninguno) |
    |}

    pago.completado y pago.reembolsado no tienen consumidor todavía: un futuro
    servicio de notificaciones o reportes puede suscribirse a ellos.
end note

LAYOUT_WITH_LEGEND()

@enduml
