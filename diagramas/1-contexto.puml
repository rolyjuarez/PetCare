@startuml contexto
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()

title PetCare - Diagrama de Contexto (C1)

Person(cliente, "Cliente", "Busca, reserva y paga servicios")
Person(proveedor, "Proveedor", "Ofrece servicios y responde solicitudes")
Person(admin, "Administrador", "Gestiona la plataforma")

System(petcare, "PetCare System", "Plataforma de reserva de servicios para mascotas con Angular frontend, Spring Boot backend, microservicios (reservas, proveedores, pagos) y orquestador de saga")

System_Ext(pasarela, "Pasarela de Pagos", "Procesa transacciones")
System_Ext(smtp, "Servidor SMTP", "Envía notificaciones")
System_Ext(maps, "Google Maps", "Ubicaciones")
System_Ext(kafka, "Kafka Broker", "Cola de eventos")

Rel(cliente, petcare, "Crea reservas, paga")
Rel(proveedor, petcare, "Responde solicitudes")
Rel(admin, petcare, "Administra sistema")

Rel(petcare, pasarela, "Procesa pagos")
Rel(petcare, smtp, "Envía emails")
Rel(petcare, maps, "Geolocalización")
Rel(petcare, kafka, "Publica/consume eventos")

SHOW_LEGEND()
@enduml
