@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(cliente, "Cliente", "Usuario que reserva servicios para mascotas")
Person(administrador, "Administrador", "Gestiona usuarios, módulos y operaciones del sistema")
Person(proveedor, "Proveedor", "Prestador de servicios veterinarios y de cuidado")

System(petcare, "PETCare", "Plataforma web full-stack para gestionar mascotas, reservas, pagos, usuarios y notificaciones")
System_Ext(db, "PostgreSQL", "Base de datos relacional principal del sistema")
System_Ext(email, "SMTP Gmail", "Envío de correos transaccionales")
System_Ext(maps, "Google Maps API", "Geolocalización y mapas")
System_Ext(storage, "Almacenamiento local", "Archivos y fotos subidos por usuarios")

Rel(cliente, petcare, "Usa la aplicación para reservar servicios")
Rel(administrador, petcare, "Administra módulos y operaciones")
Rel(proveedor, petcare, "Gestiona servicios y reservas")
Rel(petcare, db, "Guarda y consulta datos de negocio")
Rel(petcare, email, "Envía correos de registro, recuperación y notificaciones")
Rel(petcare, maps, "Consulta mapas y geolocalización")
Rel(petcare, storage, "Sube y consulta archivos")

@enduml 