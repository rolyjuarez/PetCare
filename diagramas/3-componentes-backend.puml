@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(user, "Usuario", "Cliente de la aplicación web o móvil")

System_Boundary(api_boundary, "Backend PetCare") {
    Container(api, "API REST", "Spring Boot 3.4.1", "Expone endpoints REST y orquesta la lógica de negocio")
    Container(controllers, "Controllers", "Spring MVC", "Acepta solicitudes HTTP y llama a los servicios de aplicación")
    Container(services, "Service Layer", "Spring Services", "Implementa casos de uso y lógica de negocio")
    Container(repositories, "Persistence Layer", "MyBatis + XML Mappers", "Acceso a datos y consultas SQL")
    Container(common, "Common / Infra", "Spring Components", "Configuración compartida, manejo de errores y utilidades transversales")
}

ContainerDb(db, "PostgreSQL", "Base de datos relacional", "Almacena clientes, mascotas, reservas, pagos y usuarios")
Container_Ext(email, "SMTP Gmail", "Servicio de correo", "Envía notificaciones y emails transaccionales")
Container_Ext(storage, "Almacenamiento local", "File storage", "Guarda archivos y fotos de mascotas")

Rel(user, api, "Consume API /api/v1")
Rel(api, controllers, "Dirige solicitudes a")
Rel(controllers, services, "Invoca")
Rel(services, repositories, "Usa")
Rel(services, common, "Usa para tareas transversales")
Rel(repositories, db, "Lee y escribe datos")
Rel(common, db, "Accede a configuración y datos auxiliares")
Rel(common, storage, "Guarda archivos")
Rel(common, email, "Envía correos")
@enduml
