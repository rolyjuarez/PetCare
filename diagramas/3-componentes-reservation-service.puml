@startuml componentes_reservation
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title PetCare - Reservation Service - Componentes CQRS (C3)

Container(reservation_container, "Reservation Service (8081)") {
    
    Container(write_container, "WRITE SIDE - Comandos") {
        Component(command_interface, "ReservaCommandUseCase", "Interface", "Define casos de uso de escritura")
        
        Component(command_service, "ReservaCommandService", "Service", "Implementa: crear, actualizar, cancelar, confirmar, rechazar reserva")
        
        Component(command_objects, "Command Objects", "POJO", "CrearReservaCommand, ActualizarReservaCommand, CancelarReservaCommand, ConfirmarReservaCommand, RechazarReservaCommand")
        
        Component(validator, "ReservaDatosValidator", "Validator", "Valida datos de entrada (montos, fechas, etc.)")
        
        Component(command_repo, "ReservaCommandRepository", "Repository Port", "INSERT/UPDATE en tabla reserva")
        
        Component(notifier, "ReservaNotifier", "Event Publisher", "Publica ReservaCreadaEvent, ReservaConfirmadaEvent, ReservaCanceladaEvent")
    }
    
    Container(read_container, "READ SIDE - Queries") {
        Component(query_interface, "ReservaQueryService", "Interface", "Define casos de uso de lectura")
        
        Component(query_impl, "ReservaQueryServiceImpl", "Service", "Implementa queries de lectura")
        
        Component(query_repo, "ReservaQueryRepository", "Repository Port", "SELECT ONLY de tabla reserva")
        
        Component(mapper, "ReservaQueryMapper", "Mapper", "Mapea ResultSet a DTO de respuesta")
    }
    
    Container(controllers, "Controllers") {
        Component(cmd_controller, "ReservaCommandController", "Controller", "POST/PUT /api/v1/reservas")
        Component(query_controller, "ReservaQueryController", "Controller", "GET /api/v1/reservas")
    }
    
    Container(kafka_layer, "Kafka Integration") {
        Component(cmd_consumer, "ConfirmarRechazarCommandConsumer", "Kafka Consumer", "Consume: ConfirmarReservaCommand, CancelarReservaCommand desde saga")
        Component(idempotency, "IdempotencyService", "Service", "Verifica evento_procesado para evitar duplicados")
    }
}

Component(database, "PostgreSQL petcaredb", "Database", "Tabla: reserva, evento_procesado")

Rel(cmd_controller, command_service, "invoca")
Rel(command_service, validator, "valida datos")
Rel(command_service, command_repo, "persiste")
Rel(command_service, notifier, "publica eventos")

Rel(query_controller, query_impl, "invoca")
Rel(query_impl, query_repo, "consulta")
Rel(query_repo, mapper, "mapea datos")

Rel(command_repo, database, "INSERT/UPDATE")
Rel(query_repo, database, "SELECT")

Rel(cmd_consumer, idempotency, "verifica")
Rel(idempotency, database, "consulta evento_procesado")
Rel(cmd_consumer, command_service, "invoca comando")

note bottom of write_container
    **WRITE SIDE:**
    - Comandos específicos para cada operación
    - Validación de datos
    - Publicación de eventos
    - Repository para INSERT/UPDATE
end note

note bottom of read_container
    **READ SIDE:**
    - Solo consultas SELECT
    - Mapeo de datos a DTO
    - Repository especializado en lectura
end note

SHOW_LEGEND()
@enduml
