<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="bo.capital.tec.pet.modules.soporte.mapper.ServicioMapper">

    <sql id="baseColumns">
        id, nombre, descripcion, duracion_minutos, precio_base, imagen_url, activo, categoria,
        created_at, updated_at, deleted, version
    </sql>
    <sql id="table">servicio</sql>

    <select id="selectById" resultType="bo.capital.tec.pet.modules.soporte.entity.Servicio">
        SELECT <include refid="baseColumns"/> FROM <include refid="table"/>
        WHERE id = #{id} AND deleted = FALSE
    </select>

    <select id="selectActive" resultType="bo.capital.tec.pet.modules.soporte.entity.Servicio">
        SELECT <include refid="baseColumns"/> FROM <include refid="table"/>
        WHERE activo = TRUE AND deleted = FALSE
        ORDER BY nombre ASC
    </select>
</mapper>
