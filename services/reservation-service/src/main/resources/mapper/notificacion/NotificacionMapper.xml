<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="bo.capital.tec.pet.modules.notificacion.mapper.NotificacionMapper">

    <sql id="table">notificacion</sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id"
            parameterType="bo.capital.tec.pet.modules.notificacion.entity.Notificacion">
        INSERT INTO <include refid="table"/> (titulo, mensaje, tipo, leida, usuario_id)
        VALUES (#{titulo}, #{mensaje}, #{tipo}, #{leida}, #{usuarioId})
    </insert>
</mapper>
